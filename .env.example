# ---------------------------------------------------------------------------
# Agendox API - environment template
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# API surface
API_PREFIX=api
API_DEFAULT_VERSION=1

# CORS: comma-separated origins, or `*` to allow any (dev only).
CORS_ORIGINS=*

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Observabilidad: Sentry (opcional). Vacío = deshabilitado (no-op).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# PostgreSQL (consumed by docker-compose to provision the database container)
# ---------------------------------------------------------------------------
POSTGRES_USER=agendox
POSTGRES_PASSWORD=agendox
POSTGRES_DB=agendox
# Host port mapped to the container's 5432.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Database connection used by the API and by drizzle-kit.
# For local (host) development pointing at the docker-compose Postgres:
#   postgresql://agendox:agendox@localhost:5432/agendox
# Inside docker-compose the API service overrides the host to `postgres`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://agendox:agendox@localhost:5432/agendox
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Base remota (Railway), para correr migraciones/seeds contra producción desde
# la máquina de desarrollo con `.\scripts\use-db.ps1 prod`. Usar la URL PÚBLICA
# (TCP proxy) del proveedor; la API en producción nunca lee esta variable.
DATABASE_URL_PROD=

# ---------------------------------------------------------------------------
# Authentication (staff JWTs). Use long, random, DISTINCT secrets in production.
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d
# Customer (OTP) sessions — separate secret from staff.
JWT_CUSTOMER_SECRET=dev-customer-secret-change-me
JWT_CUSTOMER_TTL=30m
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Super Admin (plataforma) — secreto separado del staff/customer.
JWT_SUPERADMIN_SECRET=dev-superadmin-secret-change-me
JWT_SUPERADMIN_TTL=8h
# Bootstrap del super admin (usado por `pnpm db:seed:superadmin`, upsert idempotente).
SUPERADMIN_EMAIL=admin@agendox.local
SUPERADMIN_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Email: MAIL_PROVIDER=log (dev, renders + logs only) | smtp (Nodemailer)
MAIL_PROVIDER=log
MAIL_FROM=Agendox <no-reply@agendox.local>
# SMTP transport — required when MAIL_PROVIDER=smtp. Gmail example below:
# (needs 2FA enabled + a 16-char App Password, NOT your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucuenta@gmail.com
# App Password de Gmail (16 caracteres, con o sin espacios).
# `APP_KEY` es el nombre viejo y sigue funcionando como fallback.
SMTP_PASS=
#
# IMPORTANTE: el dominio de MAIL_FROM tiene que coincidir con el de SMTP_USER.
# Si autenticás como @gmail.com y el From dice @agendox.local, SPF y DKIM firman
# un dominio y el correo se presenta como otro: Gmail y Outlook lo mandan a spam.
# El arranque falla si no coinciden. Con Gmail:
#   MAIL_FROM=Agendox <tucuenta@gmail.com>

# Web Push (VAPID). Generar el par con:
#   pnpm exec web-push generate-vapid-keys
# Van las dos o ninguna (el arranque falla si falta una). Si están vacías, Web
# Push queda deshabilitado y solo corren las notificaciones in-app y por email.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto real: los push services lo usan para reportar problemas y
# Safari/iOS valida el formato antes de aceptar la suscripción.
VAPID_SUBJECT=mailto:tucuenta@gmail.com

# Hours a PENDING deposit stays valid before the expiry job cancels the turn.
DEPOSIT_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Billing / subscriptions
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=mock (dev, fakes checkout end-to-end) | mercadopago
PAYMENT_PROVIDER=mock
# URLs públicas para el retorno del checkout y el webhook de la pasarela.
# Con PAYMENT_PROVIDER=mercadopago tienen que ser HTTPS públicas (el arranque
# falla si no lo son): MP rechaza un back_url en localhost y no puede entregar
# webhooks a un host que no resuelve desde internet.
APP_DASHBOARD_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
# Mercado Pago — required when PAYMENT_PROVIDER=mercadopago.
#
# NUNCA pongas credenciales reales en este archivo: está trackeado en git.
# Los valores van en el gestor de secretos del entorno (Railway, .env local).
#
# Access token de tu aplicación de MP (Panel de desarrolladores → tu app →
# Credenciales). Las de prueba y las de producción son pares distintos: un token
# `APP_USR-…` es de PRODUCCIÓN y mueve plata real.
MP_ACCESS_TOKEN=
# Public key de la misma aplicación. La API NO la usa (el flujo de preapproval
# redirige al init_point de MP); queda acá para que el front pueda leer el par
# desde un solo lugar si en algún momento monta el SDK de MP.
MP_PUBLIC_KEY=
# Clave secreta del webhook (aplicación de MP → Webhooks → "Clave secreta"),
# para verificar la firma HMAC de las notificaciones.
MP_WEBHOOK_SECRET=
