# ---------------------------------------------------------------------------
# Agendox API - environment template
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# API surface
API_PREFIX=api
API_DEFAULT_VERSION=1

# CORS: comma-separated origins, or `*` to allow any (dev only).
CORS_ORIGINS=*

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Observabilidad: Sentry (opcional). Vacío = deshabilitado (no-op).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# PostgreSQL (consumed by docker-compose to provision the database container)
# ---------------------------------------------------------------------------
POSTGRES_USER=agendox
POSTGRES_PASSWORD=agendox
POSTGRES_DB=agendox
# Host port mapped to the container's 5432.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Database connection used by the API and by drizzle-kit.
# For local (host) development pointing at the docker-compose Postgres:
#   postgresql://agendox:agendox@localhost:5432/agendox
# Inside docker-compose the API service overrides the host to `postgres`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://agendox:agendox@localhost:5432/agendox
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Authentication (staff JWTs). Use long, random, DISTINCT secrets in production.
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d
# Customer (OTP) sessions — separate secret from staff.
JWT_CUSTOMER_SECRET=dev-customer-secret-change-me
JWT_CUSTOMER_TTL=30m
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Super Admin (plataforma) — secreto separado del staff/customer.
JWT_SUPERADMIN_SECRET=dev-superadmin-secret-change-me
JWT_SUPERADMIN_TTL=8h
# Bootstrap del super admin (usado por `pnpm db:seed:superadmin`, upsert idempotente).
SUPERADMIN_EMAIL=admin@agendox.local
SUPERADMIN_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Email: MAIL_PROVIDER=log (dev, renders + logs only) | smtp (Nodemailer)
MAIL_PROVIDER=log
MAIL_FROM=Agendox <no-reply@agendox.local>
# SMTP transport — required when MAIL_PROVIDER=smtp. Gmail example below:
# (needs 2FA enabled + a 16-char App Password, NOT your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucuenta@gmail.com
# App Password de Gmail (16 caracteres, sin espacios o con ellos)
APP_KEY=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# If empty, Web Push is disabled (no-op) and only in-app + email run.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@agendox.local

# Hours a PENDING deposit stays valid before the expiry job cancels the turn.
DEPOSIT_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Billing / subscriptions
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=mock (dev, fakes checkout end-to-end) | mercadopago
PAYMENT_PROVIDER=mock
# Public URLs used for the checkout return + provider webhook. In prod use HTTPS.
APP_DASHBOARD_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
# Mercado Pago — required when PAYMENT_PROVIDER=mercadopago.
# Access token from your MP application. The values below are the SANDBOX/TEST
# credentials of the shared test application: no real money moves, they only
# simulate the subscription checkout. Replace them in production.
MP_ACCESS_TOKEN=APP_USR-5098242771236077-081014-95407decb9483c0f35f1a058fbfcbcdd-1563498300
# Public key of the same MP application. The API does NOT use it (the preapproval
# flow redirects the payer to MP's init_point); it is here so the dashboard/front
# can read the pair from one place when it mounts the MP SDK.
MP_PUBLIC_KEY=APP_USR-e1c429a2-1fca-456c-8d64-1d98547cbe19
# Webhook secret (MP application → Webhooks → "Clave secreta") to verify the HMAC
# signature. Below is the TEST application's secret; use the production one in prod.
MP_WEBHOOK_SECRET=90d978fab1f8f113d383571454cf64f22ae38a64c2574cf26d9f8563e6d5556e
